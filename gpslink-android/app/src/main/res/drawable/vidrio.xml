<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: translucent, a little lighter at the top, thin light border.
     Over the app's soft background it reads like frosted glass. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/vidrio_abajo"
        android:startColor="@color/vidrio_arriba" />
    <stroke android:width="1dp" android:color="@color/vidrio_borde" />
    <corners android:radius="28dp" />
</shape>
